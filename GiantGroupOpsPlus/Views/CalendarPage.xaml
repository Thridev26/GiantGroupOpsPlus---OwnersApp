<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GiantGroupOpsPlus.ViewModels"
             xmlns:models="clr-namespace:GiantGroupOpsPlus.Models"
             xmlns:ctrl="clr-namespace:GiantGroupOpsPlus.Views.Controls"
             x:Class="GiantGroupOpsPlus.Views.CalendarPage"
             x:DataType="vm:CalendarViewModel"
             Title="Calendar">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Padding="12,8,12,0" ColumnSpacing="6">
            <Button Grid.Column="0" Text="‹" Command="{Binding PreviousCommand}" Style="{StaticResource OutlineButton}" MinimumHeightRequest="40" MinimumWidthRequest="44" Padding="0" FontSize="20" />
            <Label Grid.Column="1" Text="{Binding MonthText}" Style="{StaticResource Title2}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="›" Command="{Binding NextCommand}" Style="{StaticResource OutlineButton}" MinimumHeightRequest="40" MinimumWidthRequest="44" Padding="0" FontSize="20" />
            <Button Grid.Column="3" Text="Today" Command="{Binding TodayCommand}" Style="{StaticResource TextButton}" MinimumHeightRequest="40" Padding="8,0" />
        </Grid>
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="16,6,8,2">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Filters}" BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />
        </ScrollView>
        <Label Grid.Row="2" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="20,2,16,4" />
        <ctrl:BannerView Grid.Row="3" />
        <RefreshView Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Days}" IsGrouped="True" SelectionMode="Single" SelectionChanged="OnSelected" Margin="16,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer><BoxView HeightRequest="24" Color="Transparent" /></CollectionView.Footer>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:CalendarDay">
                        <Label Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="2,14,0,4" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CalendarEvent">
                        <Border Padding="14">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                                <Label Grid.Row="0" Text="{Binding Title}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                <ctrl:StatusChip Grid.Row="0" Grid.Column="1" Status="{Binding Status}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Address}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ItemsText}" FontSize="13" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding CrewText}" IsVisible="{Binding HasCrewText}" TextColor="{StaticResource Info}" FontSize="12.5" LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
        <Label Grid.Row="4" Text="Nothing scheduled this month." Style="{StaticResource Muted}" IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center" />
        <VerticalStackLayout Grid.Row="4" IsVisible="{Binding HasError}" Padding="24" Spacing="12" VerticalOptions="Center">
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center" />
            <Button Text="Try again" Command="{Binding RetryCommand}" Style="{StaticResource OutlineButton}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

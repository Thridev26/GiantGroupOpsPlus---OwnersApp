<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GiantGroupOpsPlus.ViewModels"
             xmlns:models="clr-namespace:GiantGroupOpsPlus.Models"
             xmlns:ctrl="clr-namespace:GiantGroupOpsPlus.Views.Controls"
             x:Class="GiantGroupOpsPlus.Views.QuoteDetailPage"
             x:DataType="vm:QuoteDetailViewModel"
             Title="Quotation">
    <Grid RowDefinitions="Auto,*">
        <ctrl:BannerView Grid.Row="0" />
        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16,12,16,32" Spacing="14">
                    <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="10">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
                        <Button Text="Try again" Command="{Binding RetryCommand}" Style="{StaticResource OutlineButton}" />
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="14" IsVisible="{Binding HasDetail}">
                        <Border Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Detail.QuoteId, StringFormat='Quote #{0}'}" Style="{StaticResource Title2}" />
                                    <ctrl:StatusChip Grid.Column="1" Status="{Binding Detail.Status}" />
                                </Grid>
                                <Label Text="{Binding Detail.ClientName}" FontFamily="OpenSansSemibold" FontSize="16" />
                                <Label Text="{Binding Detail.SiteAddress}" Style="{StaticResource Muted}" />
                                <Label Text="{Binding Detail.ExpiryText}" TextColor="{StaticResource Info}" FontSize="13" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,6,0,0">
                                    <Button Grid.Column="0" Text="📞 Call" Style="{StaticResource OutlineButton}" Command="{Binding CallCommand}" FontSize="13" Padding="4,0" />
                                    <Button Grid.Column="1" Text="✉ Email" Style="{StaticResource OutlineButton}" Command="{Binding EmailCommand}" FontSize="13" Padding="4,0" />
                                    <Button Grid.Column="2" Text="Request" Style="{StaticResource OutlineButton}" Command="{Binding OpenRequestCommand}" FontSize="13" Padding="4,0" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="PRICE BREAKDOWN" Style="{StaticResource SectionLabel}" />
                                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Lines}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:QuoteLine">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                                <Label Grid.Column="1" Text="{Binding TotalText}" />
                                                <Label Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <BoxView HeightRequest="1" Color="{StaticResource PrimaryLight}" />
                                <Grid ColumnDefinitions="*,Auto"><Label Text="Services" /><Label Grid.Column="1" Text="{Binding ServicesText}" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <Label Text="Travel" /><Label Grid.Column="1" Text="{Binding TravelText}" />
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TravelNote}" Style="{StaticResource Muted}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto"><Label Text="Subtotal" /><Label Grid.Column="1" Text="{Binding SubtotalText}" /></Grid>
                                <Grid ColumnDefinitions="*,Auto"><Label Text="VAT (15%)" /><Label Grid.Column="1" Text="{Binding VatText}" /></Grid>
                                <BoxView HeightRequest="1" Color="{StaticResource PrimaryLight}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Total" Style="{StaticResource Title2}" />
                                    <Label Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource Title2}" TextColor="{StaticResource Primary}" />
                                </Grid>
                                <Label Text="{Binding EditedText}" IsVisible="{Binding AmountEdited}" TextColor="{StaticResource Warning}" FontSize="12.5" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="MANAGE QUOTE" Style="{StaticResource SectionLabel}" />
                                <Button Text="Change status" Command="{Binding ChangeStatusCommand}" IsEnabled="{Binding IsNotBusy}" />
                                <Button Text="Edit amount" Command="{Binding EditAmountCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource OutlineButton}" />
                                <Button Text="Extend expiry date" Command="{Binding ExtendExpiryCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource OutlineButton}" />
                                <Button Text="Share quote summary" Command="{Binding ShareCommand}" Style="{StaticResource OutlineButton}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>

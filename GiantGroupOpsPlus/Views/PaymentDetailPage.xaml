<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GiantGroupOpsPlus.ViewModels"
             xmlns:models="clr-namespace:GiantGroupOpsPlus.Models"
             xmlns:ctrl="clr-namespace:GiantGroupOpsPlus.Views.Controls"
             x:Class="GiantGroupOpsPlus.Views.PaymentDetailPage"
             x:DataType="vm:PaymentDetailViewModel"
             Title="Payments">
    <Grid RowDefinitions="Auto,*">
        <ctrl:BannerView Grid.Row="0" />
        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16,12,16,32" Spacing="14">
                    <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="10">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
                        <Button Text="Try again" Command="{Binding RetryCommand}" Style="{StaticResource OutlineButton}" />
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="14" IsVisible="{Binding HasDetail}">
                        <Border Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Detail.JobId, StringFormat='Job #{0}'}" Style="{StaticResource Title2}" />
                                <Label Text="{Binding Detail.ClientName}" FontFamily="OpenSansSemibold" FontSize="16" />
                                <Label Text="{Binding Detail.SiteAddress}" Style="{StaticResource Muted}" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,6,0,0">
                                    <VerticalStackLayout><Label Text="INVOICE" Style="{StaticResource SectionLabel}" FontSize="10.5" /><Label Text="{Binding InvoiceText}" FontFamily="OpenSansSemibold" /></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"><Label Text="PAID" Style="{StaticResource SectionLabel}" FontSize="10.5" /><Label Text="{Binding PaidText}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Success}" /></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2"><Label Text="BALANCE" Style="{StaticResource SectionLabel}" FontSize="10.5" /><Label Text="{Binding BalanceText}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Warning}" /></VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
                                    <Button Text="📞 Call client" Style="{StaticResource OutlineButton}" Command="{Binding CallCommand}" FontSize="13" Padding="4,0" />
                                    <Button Grid.Column="1" Text="Open job" Style="{StaticResource OutlineButton}" Command="{Binding OpenJobCommand}" FontSize="13" Padding="4,0" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" IsVisible="{Binding CanRecord}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="RECORD A PAYMENT" Style="{StaticResource SectionLabel}" />
                                <Border Padding="12,0"><Entry Text="{Binding AmountText}" Placeholder="Amount received (R)" Keyboard="Numeric" /></Border>
                                <Button Text="Use full balance" Command="{Binding PayFullBalanceCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Start" MinimumHeightRequest="36" Padding="4,0" />
                                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Methods}" BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />
                                </ScrollView>
                                <Border Padding="12,0"><Entry Text="{Binding ReferenceText}" Placeholder="Reference (optional)" MaxLength="100" /></Border>
                                <Button Text="Record payment" Command="{Binding RecordCommand}" IsEnabled="{Binding IsNotBusy}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="PAYMENT HISTORY" Style="{StaticResource SectionLabel}" />
                                <Label Text="No payments yet." Style="{StaticResource Muted}" IsVisible="{Binding HasHistory, Converter={StaticResource InvertedBool}}" />
                                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding History}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:PaymentEntry">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <Label Text="{Binding AmountText}" FontFamily="OpenSansSemibold" />
                                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DetailText}" Style="{StaticResource Muted}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>

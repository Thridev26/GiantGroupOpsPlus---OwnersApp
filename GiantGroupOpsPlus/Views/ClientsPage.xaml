<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GiantGroupOpsPlus.ViewModels"
             xmlns:models="clr-namespace:GiantGroupOpsPlus.Models"
             xmlns:ctrl="clr-namespace:GiantGroupOpsPlus.Views.Controls"
             x:Class="GiantGroupOpsPlus.Views.ClientsPage"
             x:DataType="vm:ClientsViewModel"
             Title="Clients">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋ Add" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <SearchBar Grid.Row="0" Placeholder="Search name, email or phone" Text="{Binding SearchText}" Margin="8,4,8,0" />
        <Label Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="20,4,16,4" />
        <ctrl:BannerView Grid.Row="2" />
        <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Clients}" SelectionMode="Single" SelectionChanged="OnSelected" Margin="16,0">
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="10" /></CollectionView.ItemsLayout>
                <CollectionView.Header><BoxView HeightRequest="2" Color="Transparent" /></CollectionView.Header>
                <CollectionView.Footer><BoxView HeightRequest="24" Color="Transparent" /></CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ClientSummary">
                        <Border Padding="14">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                <Label Grid.Row="0" Text="{Binding FullName}" FontFamily="OpenSansSemibold" FontSize="15" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding TypeText}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ContactText}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding RequestCountText}" TextColor="{StaticResource Info}" FontSize="12.5" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
        <Label Grid.Row="3" Text="No clients match." Style="{StaticResource Muted}" IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center" />
        <VerticalStackLayout Grid.Row="3" IsVisible="{Binding HasError}" Padding="24" Spacing="12" VerticalOptions="Center">
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center" />
            <Button Text="Try again" Command="{Binding RetryCommand}" Style="{StaticResource OutlineButton}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

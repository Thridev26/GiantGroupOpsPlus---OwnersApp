<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GiantGroupOpsPlus.ViewModels"
             xmlns:conv="clr-namespace:GiantGroupOpsPlus.Converters"
             x:Class="GiantGroupOpsPlus.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertedBoolConverter x:Key="InvertedBool" />
            <conv:StatusToColorConverter x:Key="StatusToColor" />

            <!-- Selectable filter / segmented chip, used by every list and the job status selector -->
            <DataTemplate x:Key="FilterChipTemplate" x:DataType="vm:FilterOption">
                <Border Padding="14,8" Margin="0,0,8,0"
                        StrokeShape="RoundRectangle 20">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Label}" FontSize="13" FontFamily="OpenSansSemibold" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
